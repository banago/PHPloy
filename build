#!/usr/bin/env php
<?php

/**
 * Build phploy.phar straight from the checkout — src/ plus the full vendor/
 * (dev dependencies included). Simplicity over size: no staging, no composer step.
 */

$filename    = 'phploy.phar';
$output_file = __DIR__ . '/dist/' . $filename;

@unlink($output_file);
@mkdir(__DIR__ . '/dist', 0755, true);

$phar = new Phar($output_file, FilesystemIterator::CURRENT_AS_FILEINFO | FilesystemIterator::KEY_AS_FILENAME, $filename);
$phar->startBuffering();
$phar->buildFromDirectory(__DIR__, '~^(?:.*/)?(?:phploy\.php|src/|vendor/)~');
$stub = "#!/usr/bin/env php \n" . $phar->createDefaultStub('phploy.php');
$phar->setStub($stub);
$phar->compressFiles(Phar::GZ);
$phar->stopBuffering();

chmod($output_file, 0755);

echo 'Build was successful: ' . $output_file . PHP_EOL;
